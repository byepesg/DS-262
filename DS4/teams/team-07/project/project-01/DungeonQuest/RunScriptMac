#!/bin/bash


# 1. Configuración de variables
GODOT_VERSION="4.6" 
GODOT_URL="https://github.com{GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_macos.universal.zip"
ZIP_NAME="Godot.zip"
APP_NAME="Godot.app"
INSTALL_DIR="/Applications"


# Pedir la ruta del proyecto al usuario
echo "📁 Por favor, arrastra o escribe la ruta de la carpeta de tu proyecto de Godot y presiona Enter:"
read -r PROJECT_PATH


# Limpiar comillas o espacios extras de la ruta si se arrastró la carpeta
PROJECT_PATH=$(echo "$PROJECT_PATH" | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")


# 2. Verificar o instalar Godot
if [ ! -d "$INSTALL_DIR/$APP_NAME" ]; then
    echo "📥 Godot no está instalado. Descargando versión ${GODOT_VERSION}..."
    curl -L -o "$ZIP_NAME" "$GODOT_URL"
    
    echo "📦 Descomprimiendo..."
    unzip -q "$ZIP_NAME"
    
    echo "🚀 Moviendo a la carpeta de Aplicaciones..."
    mv "$APP_NAME" "$INSTALL_DIR/"
    
    echo "🧹 Limpiando archivos temporales..."
    rm "$ZIP_NAME"
    
    # Bypass para la seguridad de macOS (Gatekeeper) ya que se descarga por curl
    echo "🔓 Autorizando la aplicación en macOS..."
    xattr -dr com.apple.quarantine "$INSTALL_DIR/$APP_NAME"
    
    echo "✅ ¡Godot instalado con éxito!"
else
    echo "✨ Godot ya está instalado en tu sistema."
fi


# 3. Correr el proyecto seleccionado
if [ -f "$PROJECT_PATH/project.godot" ]; then
    echo "🎮 Abriendo el proyecto: $PROJECT_PATH"
    "$INSTALL_DIR/$APP_NAME/Contents/MacOS/Godot" --path "$PROJECT_PATH" &
else
    echo "❌ Error: No se encontró un archivo 'project.godot' en la ruta especificada."
    exit 1
fi
